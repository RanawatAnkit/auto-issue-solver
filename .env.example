# Copy to .env and fill in. Never commit .env.

# Database (DATABASE_URL is built from these unless set explicitly)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auto_issue_solver
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auto_issue_solver

REDIS_URL=redis://localhost:6379/0

# GitHub App (Issues, Pull requests, Contents: read & write; Metadata: read)
GITHUB_APP_ID=
# Path to the downloaded .pem file, or the PEM text itself (\n-escaped on one line)
GITHUB_APP_PRIVATE_KEY=
# Required: webhooks are rejected until this is set
GITHUB_WEBHOOK_SECRET=

# GitHub OAuth App (dashboard login)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
FRONTEND_URL=http://localhost:5173
SESSION_SECRET_KEY=change-me
SESSION_EXPIRE_HOURS=24

# LLM provider: ollama (local, free), gemini or openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Seconds per request. Local 7B models can need several minutes for code generation.
OLLAMA_TIMEOUT=600
# Context window in tokens. Ollama's default (2048 on many installs) silently cuts
# off long prompts; keep this at 16384+ for repository-scale prompts.
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096
MAX_LLM_RETRIES=2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional fallback provider (ollama, gemini or openai)
LLM_FALLBACK_PROVIDER=
# quota = fall back only on quota/rate-limit errors; unavailable = also when the primary is down
LLM_FALLBACK_ON=quota
# Falling back to gemini/openai can cost money: it only happens when this is true
LLM_ALLOW_PAID_FALLBACK=false

# Search and Indexing
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=100
MAX_FILE_SIZE_MB=1
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Sandbox (build the image from sandbox/Dockerfile)
SANDBOX_IMAGE=test-sandbox:latest
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_CPU_LIMIT=1
TEST_TIMEOUT_SECONDS=300

# Pipeline safeguards
# false: stop after analysis + plan (PLAN_READY); nothing is modified anywhere
ENABLE_CODE_MUTATION=false
# With mutation enabled: true pushes a branch and opens a PR after tests pass;
# false stops at COMPLETED after local verification (nothing written to GitHub)
ENABLE_PR_CREATION=true
MAX_REPAIR_ATTEMPTS=3
REPAIR_TIME_BUDGET_SECONDS=3600
RUN_STALE_AFTER_MINUTES=180
